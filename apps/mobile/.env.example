# Public API origin only. For a physical phone use a reachable HTTPS tunnel
# or deployment; localhost refers to the phone, not your development computer.
# node scripts/dev-api-tunnel.mjs --write-env can set this in .env.local.
EXPO_PUBLIC_API_BASE_URL=
# Public HTTPS frontend origin for Privy and the MWA app identity.
# An API-only tunnel does not serve sign-in pages. Defaults to API origin.
EXPO_PUBLIC_WEB_URL=
# Never put Jupiter API keys, trade authorization secrets or Privy secrets here.
# All EXPO_PUBLIC_* values are bundled into the app and readable by its users.
