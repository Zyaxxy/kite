{
  "expo": {
    "name": "Kite",
    "slug": "kite-solana-stocks",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#101311"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kite.solana"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#101311"
      },
      "package": "com.kite.solana"
    },
    "scheme": "kite",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "web": {
      "bundler": "metro",
      "name": "Kite — Tokenized equities",
      "shortName": "Kite",
      "description": "Explore live tokenized equities, practice with paper funds and trade from your own wallet.",
      "backgroundColor": "#101311",
      "themeColor": "#101311"
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
