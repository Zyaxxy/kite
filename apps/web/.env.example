# Optional public Privy app ID. Enable Solana embedded wallets in the Privy dashboard.
NEXT_PUBLIC_PRIVY_APP_ID=
# Public client RPC endpoint; it must be Solana mainnet. Use a browser-safe, origin-restricted key.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Optional matching browser WebSocket endpoint for Privy.
NEXT_PUBLIC_SOLANA_WS_URL=
# Server-side RPC endpoint for portfolio balances (prefer your dedicated provider).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Server-only Jupiter API key for supported discovery and actual swap routes.
JUPITER_API_KEY=
# Server-only quote authorization secret shared across deployment instances.
KITE_TRADE_SECRET=

# Server-only Privy secret if a server-side Privy feature requires it.
PRIVY_APP_SECRET=
# Canonical HTTPS public origin for metadata, sitemap and HTTP redirects.
KITE_SITE_URL=
# Exact comma-separated browser origins allowed to call the API (Expo web).
# Native apps have no Origin header. Do not use *.
KITE_ALLOWED_ORIGINS=
# Only enable behind a reverse proxy that overwrites forwarded protocol/IP headers.
# Vercel is automatically detected. Local development does not need this.
KITE_TRUST_PROXY=false
# Identify the deployment operator and public support contact in policy pages.
KITE_OPERATOR_NAME=
KITE_SUPPORT_EMAIL=
# Optional Plausible site domain. Public identifier, not an API key.
# Analytics requests only start after visitor consent; must match the site hostname.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Recurring investments: self-hosted API with a private durable volume (not ephemeral Vercel storage).
# The public signing address of your separately operated executor; never a private key.
KITE_INVESTING_EXECUTOR=
# Absolute private directory (0700), shared by all API processes serving these plans.
KITE_INVESTING_STATE_DIR=
# Server/worker-only bearer credential, at least 32 random characters; distinct from KITE_TRADE_SECRET.
KITE_RECURRING_EXECUTOR_SECRET=
# Worker only: configured in its secret environment, never NEXT_PUBLIC or EXPO_PUBLIC.
KITE_WEB_API_URL=
KITE_BUYER_KEYPAIR_PATH=
KITE_RECURRING_WORKER_STATE_DIR=
