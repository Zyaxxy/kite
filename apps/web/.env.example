# Optional public Privy app ID. Enable Solana embedded wallets in the Privy dashboard.
NEXT_PUBLIC_PRIVY_APP_ID=
# Public client RPC endpoint; it must be Solana mainnet. Use a browser-safe, origin-restricted key.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Optional matching browser WebSocket endpoint for Privy.
NEXT_PUBLIC_SOLANA_WS_URL=
# Server-side mainnet RPC for balances, transaction preparation, simulation and broadcast.
# Public RPC defaults are for development; configure provider quotas for a public demo.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Server-only Jupiter API key for supported discovery and actual swap routes.
JUPITER_API_KEY=
# Server-only quote authorization secret (32+ random characters), stable across instances.
KITE_TRADE_SECRET=

# Canonical HTTPS public origin for metadata, sitemap and HTTP redirects.
KITE_SITE_URL=
# Exact comma-separated browser origins allowed to call the API (Expo web).
# Native apps have no Origin header. Do not use *.
KITE_ALLOWED_ORIGINS=
# Only enable behind a reverse proxy that overwrites forwarded protocol/IP headers.
# Vercel is automatically detected. Local development does not need this.
KITE_TRUST_PROXY=false
# Identify the deployment operator and public support contact in policy pages.
KITE_OPERATOR_NAME=
KITE_SUPPORT_EMAIL=
# Optional Plausible site domain. Public identifier, not an API key.
# Analytics requests only start after visitor consent; must match the site hostname.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Recurring backend is devnet-only, independently genesis-checked on prepare and broadcast.
# Current devnet design collects test KUSD and mints mock stocks; it does not use AMM pools.
# Catalog/mints: apps/web/public/xstocks-devnet/xstocks.json (public metadata, not secrets).
# Known contract blockers and verification commands: docs/devnet-contract-audit.md.
# Mainnet spot trading continues to use SOLANA_RPC_URL above.
KITE_RECURRING_RPC_URL=https://api.devnet.solana.com
# Server-only HMAC secret (32+ characters), distinct from KITE_TRADE_SECRET.
# Authorizes reviewed messages; this is not a wallet key and cannot spend tokens.
KITE_RECURRING_AUTH_SECRET=
# No keeper/buyer/swapper or mint-authority private key belongs in the web deployment.
# The collect API prepares an unsigned transaction. A cron/collector is separate future work.
# Native APK configuration belongs in apps/mobile/.env.example and the EAS environment.
