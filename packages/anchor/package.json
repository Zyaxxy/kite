{
  "name": "@kite/anchor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "pnpm test:native && pnpm test:idl && pnpm test:runtime",
    "test:native": "cargo test -p kite_guard",
    "test:idl": "node scripts/sync-idl.cjs --check",
    "test:runtime": "node --test tests/runtime.test.cjs",
    "test:fixtures": "node scripts/fetch-runtime-programs.cjs",
    "test:build": "cargo build-sbf --manifest-path programs/kite_guard/Cargo.toml --sbf-out-dir target/test-programs",
    "idl:sync": "node scripts/sync-idl.cjs"
  },
  "dependencies": {
    "@anchor-lang/core": "^1.2.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.5",
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.6",
    "@types/node": "^22.10.2",
    "chai": "^4.3.4",
    "litesvm": "1.2.1",
    "mocha": "^10.2.0",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.7.3"
  }
}
